# ============================================================================
# pen_bowl_vla_jepa — configuration. EVERY script sources this file; it is the
# single source of truth. Edit values here, never inside the scripts.
#
# Task:   pick up the pen and put it in the bowl (SO-101, one arm)
# Policy: VLA-JEPA (Qwen3-VL-2B vision-language backbone + DiT flow-matching
#         action head + V-JEPA2 world model that predicts future wrist-camera
#         frames during training), fine-tuned from lerobot/VLA-JEPA-SimplerEnv
#         (the single-camera checkpoint) on THIS machine's two RTX 5090s.
# Camera: ONLY the gripper-mounted (wrist) camera. Same dataset and the same
#         hardware/camera settings as ../pen_bowl_act (copied verbatim below;
#         the policy must see exactly what was recorded).
# ============================================================================

# Hugging Face account (dataset and model).
HF_USER=fouad1233

# Python stack: lelab's uv tool venv (same as tshirt_fold_pi05). It already has
# torch 2.11+cu128 (sm_120, verified on both 5090s), lerobot 0.6.0, accelerate,
# rerun, pynput and matplotlib. ../.venv in this repo has no torch at all.
# Do NOT `uv tool upgrade lelab` while recording/training (see CLAUDE.md).
VENV_BIN=/home/gtu-dsa/.local/share/uv/tools/lelab/bin

# --- Arms -----------------------------------------------------------------
# Identified by USB serial, NOT by /dev/ttyACM number: the ACM numbers swap on
# every replug/reboot. The scripts resolve these serials to the current port
# every time they start. Verified 2026-10-11 by reading each arm's motor
# EEPROM homing offsets and matching them to the calibration files.
LEADER_SERIAL=5B42000617
FOLLOWER_SERIAL=5B42135231
# Calibration ids (files under ~/.cache/huggingface/lerobot/calibration/).
LEADER_ID=dash_so101
FOLLOWER_ID=dash_so101

# --- Task text (identical at record, train and run time) ---------------------
TASK="Pick up the pen and put it in the bowl"

# --- Camera (SINGLE SOURCE OF TRUTH for recording AND running) ---------------
# by-id path, not /dev/videoN (N changes on replug). Find it with
# ./find_camera.sh. The key name "wrist" becomes observation.images.wrist in
# the dataset and in the trained policy, so it must never change after the
# first episode is recorded.
#
# Measured 2026-10-11: this Jieli camera delivers ~25 fps at 640x480 (both
# YUYV and MJPG). Recording still runs at 30 Hz: lerobot reads the newest
# frame without blocking, so ~1 frame in 6 is a repeat. Harmless, and it
# keeps the arm control loop at the standard 30 Hz.
# warmup_s=3: this camera needs ~3 s to deliver its first frame from cold;
# lerobot's default 1 s times out.
# No rotation: the native image has the gripper fingers at the TOP of the
# frame (same as every earlier dataset with this camera). It looks upside
# down to a human but the policy does not care. Never change it mid-dataset.
CAMERAS='{"wrist": {"type": "opencv", "index_or_path": "/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0", "width": 640, "height": 480, "fps": 30, "warmup_s": 3}}'

# --- Dataset (recorded and published by ../pen_bowl_act) ----------------------
FPS=30
DATASET_REPO=${HF_USER}/so101_pen_in_bowl_wrist
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# --- Base models (downloaded with aria2c into ~/models/vla_jepa; HF's own
# downloader stalls on this network) -------------------------------------------
BASE_MODELS_DIR=${HOME}/models/vla_jepa
BASE_POLICY=${BASE_MODELS_DIR}/VLA-JEPA-SimplerEnv          # 6.2 GB, 1-camera OXE Bridge/RT-1 checkpoint
QWEN_PATH=${BASE_MODELS_DIR}/Qwen3-VL-2B-Instruct           # 4.3 GB, built at init (tokenizer/processor/config)
JEPA_PATH=${BASE_MODELS_DIR}/vjepa2-vitl-fpc64-256          # frozen V-JEPA2 video encoder (training only)
# prepare_init.py turns BASE_POLICY into a starting point for THIS robot:
# 6 joints instead of 7, a joint-state input, our camera key. Written here:
INIT_POLICY_DIR=./run/init_policy

# --- Model shape for THIS task -------------------------------------------------
# The base checkpoint predicts 7 actions (1.4 s at Bridge's 5 Hz). At our 30 Hz,
# 7 actions are only 0.23 s, so the chunk is 30 actions = 1 s of motion.
CHUNK_SIZE=30
# The world model sees 8 frames. Consecutive 30 Hz frames barely differ (0.27 s
# total), so we take every 4th frame: 8 frames spanning ~1 s, like the chunk.
VIDEO_FRAME_STRIDE=4
# Images are shrunk to 224x224 for the backbone, as in pretraining and as the
# policy already does at inference (resize_images_to).
IMAGE_SIZE=224

# --- Training (ONE RTX 5090) ------------------------------------------------------
# Measured 2026-10-15 (smoke_test.sh, 2.77B params, full fine-tune, bf16, grad ckpt):
#   1 GPU,  batch 8          -> 0.61 s/step, 13.2 samples/s, 28.9 GB peak
#   2 GPUs, batch 4 each     -> 1.94 s/step,  4.1 samples/s (DDP must move 5.5 GB of
#                               gradients per step over PCIe, no P2P, GPU1 on x4)
#   2 GPUs, batch 8 each     -> out of memory
# So: one GPU, and the other GPU is free for a second, independent experiment
# (robotics/CLAUDE.md rule 5).
NUM_GPUS=1
GPU_IDS=0                     # CUDA device(s) this run may use
BATCH_SIZE=8
NUM_WORKERS=8
# The model is already held in bf16 (policy.torch_dtype). Accelerate's autocast
# on top would re-cast it and waste memory (same lesson as tshirt_fold_pi05).
MIXED_PRECISION=no
# Recompute Qwen's activations in the backward pass instead of storing them. Needed:
# without it batch 8 runs out of the 32 GB at step 2 (measured 2026-10-15).
GRADIENT_CHECKPOINTING=true
# 8 epochs x 7,266 steps = 58k steps at batch 8 (465k samples), ~10.5 h at 13.2 samples/s.
EPOCHS=8
# The upstream recipe uses lr 1e-4 at batch 32+. lerobot 0.6.0 has no gradient
# accumulation, so at batch 8 the rate is halved (sqrt scaling: 1e-4 * sqrt(8/32)).
LR=5e-5
LR_BACKBONE=5e-5              # unused by VLA-JEPA (one learning rate); kept for train_plan.py
WARMUP_STEPS=1000
VALIDATION_SPLIT=0.1          # last 10% of episodes held out for the val curve
# A checkpoint is ~17 GB (bf16 weights + AdamW state); every 2 epochs -> 4 of them.
CHECKPOINT_EVERY_EPOCHS=2
AUGMENT=false
OUTPUT_DIR=./outputs/train/vla_jepa_pen_bowl
JOB_NAME=vla_jepa_pen_bowl
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8789           # ACT's dashboard uses 8787
THROUGHPUT_HINT=13.2          # measured samples/s on 1 GPU (smoke test)

# Publishing (2b_publish_model.sh).
MODEL_REPO=${HF_USER}/vla_jepa_pen_in_bowl_wrist
MODEL_PRIVATE=false

# --- Running the policy (3_run_autonomous.sh) ----------------------------------
# House rule: always clamp joint speed (degrees per 30 Hz tick).
MAX_RELATIVE_TARGET=30
# Actions executed from each predicted chunk of CHUNK_SIZE before predicting
# again. Smaller = reacts faster, but the arm pauses briefly at every prediction.
N_ACTION_STEPS=10
RUN_DURATION_S=0              # 0 = run until Ctrl+C
TRIAL_TIME_S=30
TRIAL_RESET_S=20
