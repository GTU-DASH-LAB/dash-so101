# ============================================================================
# pen_bowl_molmoact2 — configuration. EVERY script sources this file; it is the
# single source of truth. Edit values here, never inside the scripts.
#
# Task:   pick up the pen and put it in the bowl (SO-101, one arm)
# Policy: MolmoAct2 (Ai2): a 5.4B vision-language-action model whose SO-100/101
#         checkpoint (allenai/MolmoAct2-SO100_101) was already trained on community
#         SO-100/101 absolute-joint data. Fine-tuned with LoRA on the VLM and a fully
#         trainable flow-matching action expert, on ONE RTX 5090.
# Camera: ONLY the gripper-mounted (wrist) camera. Same dataset and the same
#         hardware/camera settings as ../pen_bowl_act (copied verbatim below;
#         the policy must see exactly what was recorded).
# ============================================================================

# Hugging Face account (dataset and model).
HF_USER=fouad1233

# Python stack: lelab's uv tool venv (same as tshirt_fold_pi05). It already has
# torch 2.11+cu128 (sm_120, verified on both 5090s), lerobot 0.6.0, accelerate,
# rerun, pynput and matplotlib. ../.venv in this repo has no torch at all.
# Do NOT `uv tool upgrade lelab` while recording/training (see CLAUDE.md).
VENV_BIN=/home/gtu-dsa/.local/share/uv/tools/lelab/bin

# --- Arms -----------------------------------------------------------------
# Identified by USB serial, NOT by /dev/ttyACM number: the ACM numbers swap on
# every replug/reboot. The scripts resolve these serials to the current port
# every time they start. Verified 2026-10-11 by reading each arm's motor
# EEPROM homing offsets and matching them to the calibration files.
LEADER_SERIAL=5B42000617
FOLLOWER_SERIAL=5B42135231
# Calibration ids (files under ~/.cache/huggingface/lerobot/calibration/).
LEADER_ID=dash_so101
FOLLOWER_ID=dash_so101

# --- Task text (identical at record, train and run time) ---------------------
TASK="Pick up the pen and put it in the bowl"

# --- Camera (SINGLE SOURCE OF TRUTH for recording AND running) ---------------
# by-id path, not /dev/videoN (N changes on replug). Find it with
# ./find_camera.sh. The key name "wrist" becomes observation.images.wrist in
# the dataset and in the trained policy, so it must never change after the
# first episode is recorded.
#
# Measured 2026-10-11: this Jieli camera delivers ~25 fps at 640x480 (both
# YUYV and MJPG). Recording still runs at 30 Hz: lerobot reads the newest
# frame without blocking, so ~1 frame in 6 is a repeat. Harmless, and it
# keeps the arm control loop at the standard 30 Hz.
# warmup_s=3: this camera needs ~3 s to deliver its first frame from cold;
# lerobot's default 1 s times out.

# --- Dataset (recorded and published by ../pen_bowl_act) ----------------------
FPS=30
DATASET_REPO=${HF_USER}/so101_pen_in_bowl_wrist
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# Training copy in MolmoAct2's joint convention (make_model_frame_dataset.py).
MODEL_FRAME_DATASET_REPO=${HF_USER}/so101_pen_in_bowl_wrist_molmo_frame
MODEL_FRAME_DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${MODEL_FRAME_DATASET_REPO}

# --- Base model (downloaded with aria2c; HF's own downloader stalls on this network)
# The policy always builds itself from this HF-format checkpoint, so the converted
# lerobot/MolmoAct2-SO100_101-LeRobot copy would only be a second 21.8 GB download.
BASE_CHECKPOINT=${HOME}/models/molmoact2/MolmoAct2-SO100_101

# --- Model settings (docs/source/molmoact2.mdx, SO-100/101 section) -----------
NORM_TAG=so100_so101_molmoact2
SETUP_TYPE="single so100/so101 robotic arm in molmoact2"
CONTROL_MODE="absolute joint pose"
# The checkpoint was trained on the OLD SO-100/101 joint convention. LeRobot >= 0.5
# calibration differs: shoulder_lift is flipped and shoulder_lift/elbow_flex are
# shifted by 90 deg: model = sign * arm + offset. Training uses a converted copy of
# the dataset (make_model_frame_dataset.py); deployment converts state in / actions
# out (deploy_config.py). See those scripts for why not the processor flags alone.
JOINT_SIGNS='[1, -1, 1, 1, 1, 1]'
JOINT_OFFSETS='[0, 90, 90, 0, 0, 0]'
CHUNK_SIZE=30                 # 1 s at 30 Hz, as the SO-100/101 checkpoint

# --- Training (ONE RTX 5090; the other GPU trains VLA-JEPA) ---------------------
# Docs, datasets under 200 demos: LoRA on the VLM, action expert fully trainable,
# global batch 16-32, gradient checkpointing. Docs' memory table: LoRA bs 16 = 26.8 GiB.
NUM_GPUS=1
GPU_IDS=1
BATCH_SIZE=16
NUM_WORKERS=10
MIXED_PRECISION=bf16
# Measured 2026-10-15 (smoke_test.sh): batch 16 on one 5090 -> 2.06 s/step, 7.5 samples/s,
# 23.6 GB peak, 727M trainable of 5.6B. 5 epochs = 18,165 steps x 16 = 290k samples,
# about the docs' 10k steps x batch 32. ~11 h + validation.
EPOCHS=5
LR=1e-5                       # the policy's preset rates (VLM 1e-5, action expert 5e-5)
LR_BACKBONE=1e-5              # unused; kept for train_plan.py
VALIDATION_SPLIT=0.1
CHECKPOINT_EVERY_EPOCHS=1
# The docs fine-tune with augmentation on. It runs on the CPU (~190 samples/s here),
# far above what a 5B model consumes, so it costs nothing.
AUGMENT=true
OUTPUT_DIR=./outputs/train/molmoact2_pen_bowl
JOB_NAME=molmoact2_pen_bowl
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8790
THROUGHPUT_HINT=7.5           # measured samples/s (smoke test, batch 16)

MODEL_REPO=${HF_USER}/molmoact2_pen_in_bowl_wrist
MODEL_PRIVATE=false

# --- Running the policy (3_run_autonomous.sh) ----------------------------------
MAX_RELATIVE_TARGET=5
N_ACTION_STEPS=15
RUN_DURATION_S=0
TRIAL_TIME_S=30
TRIAL_RESET_S=20
