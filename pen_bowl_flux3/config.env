# ============================================================================
# pen_bowl_flux3 — configuration (single source of truth; scripts source it).
#
# Task:   pick up the pen and put it in the bowl (SO-101, one arm)
# Policy: FLUX 3 Action (Black Forest Labs), a 7B "world action model": it denoises
#         the next 32 actions TOGETHER with the next video frames. LoRA fine-tune of
#         black-forest-labs/flux-3-action-so101 (already trained on SO-101 at 30 Hz).
# Camera: ONLY the wrist camera. The SO-101 checkpoint saw scene|wrist side by side
#         (each 256x256); here the wrist alone fills a 256x256 canvas ("single" layout),
#         i.e. the wrist image looks exactly as it did in pretraining.
# Where:  trained on AWS (1x H100 80 GB, aws/gpu_box.sh), run on this PC's RTX 5090.
# License: the FLUX 3 weights are gated under Black Forest Labs' license (accepted
#         on the Hub by fouad1233); the fine-tune inherits it.
# ============================================================================
HF_USER=fouad1233
TASK="Pick up the pen and put it in the bowl"
FPS=30

# Same arm and camera as ../pen_bowl_act (the policy must see what was recorded).
FOLLOWER_SERIAL=5B42135231
FOLLOWER_ID=dash_so101
CAMERAS='{"wrist": {"type": "opencv", "index_or_path": "/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0", "width": 640, "height": 480, "fps": 30, "warmup_s": 3}}'

DATASET_REPO=${HF_USER}/so101_pen_in_bowl_wrist
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# --- Model -------------------------------------------------------------------------
BASE_POLICY_REPO=black-forest-labs/flux-3-action-so101
CAMERA_LAYOUT=single
CANVAS_HW='[256, 256]'

# --- Training (examples/flux3/lora.json, scaled to one H100) ----------------------
# lora.json: LoRA r=alpha=32, lr 1e-4 (fresh heads 5x), EMA 0.999, bf16, grad checkpointing.
# Upstream budgets: 1 GPU bs2 x accum4 for 10k microsteps; 4 GPUs bs8 x accum4 for 14k.
# Final batch/steps are set from the first measured steps on the H100 (MAX_HOURS cap).
BATCH_SIZE=8
GRAD_ACCUM=4
STEPS=6000                     # microsteps (lerobot counts microsteps with accumulation)
SAVE_FREQ=500
EVAL_SPLIT=0.1
NUM_WORKERS=12

# Python env on BOTH sides (lerobot main + natten): ./0_setup_env.sh
FLUX3_ENV=${HOME}/envs/lerobot-main

# Publishing.
MODEL_REPO=${HF_USER}/flux3_action_pen_in_bowl_wrist
MODEL_PRIVATE=false

# --- Running on the 5090 -------------------------------------------------------
MAX_RELATIVE_TARGET=5
N_ACTION_STEPS=32
VENV_BIN=${FLUX3_ENV}/bin      # lib.sh: python, lerobot-rollout, hf (all from lerobot main)
OUTPUT_DIR=./outputs/flux3_pen_bowl   # checkpoints pulled back from AWS (aws_train.sh pull)
RUN_DURATION_S=0               # 0 = until Ctrl+C
TRIAL_TIME_S=30                # --trials: seconds per attempt
TRIAL_RESET_S=20               # --trials: seconds to put the pen somewhere new
