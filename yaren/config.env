# shellcheck shell=bash
# ============================================================================
# Yaren - talk to the SO-101 and let it act (see README.md). Sourced by start.sh / stop.sh.
# Robot, cameras, checkpoint and safety limits are NOT set here: they come from
# $POLICY_DIR/config.env, the same file ./3_run_autonomous.sh uses, so the arm runs
# exactly as it does there (MAX_RELATIVE_TARGET, CAMERAS, FOLLOWER_SERIAL, ...).
# ============================================================================

POLICY_DIR=../pen_bowl_molmoact2   # MolmoAct2 pen -> bowl (TensorRT action expert)
CHECKPOINT=last                    # last | best | a step from ./3_run_autonomous.sh --list
TASK_TIMEOUT_S=30                  # a run ends after this long (as TRIAL_TIME_S), then the arm goes home

# --- GPUs: the arm's model alone on one card, everything that listens/talks/thinks on the other.
ROBOT_GPU=0                        # MolmoAct2 + TensorRT engine
VOICE_GPU=1                        # Whisper + Chatterbox + Qwen3.8 (Ollama)

# --- Ports. The robot server only listens on 127.0.0.1; only the UI ports face the user.
ROBOT_HTTP_PORT=8791
UI_HTTP_PORT=8080                  # http://127.0.0.1:8080  (on this machine)
UI_HTTPS_PORT=8443                 # https://<this machine>:8443  (a laptop on the same network)

# --- Voice side (venv ~/envs/yaren, models in ~/models/yaren; ./setup.sh makes both)
VOICE_VENV=${HOME}/envs/yaren
ASR_MODEL=${HOME}/models/yaren/whisper-large-v3-turbo
TTS_MODEL=${HOME}/models/yaren/chatterbox
VOICE_REFS=${HOME}/models/yaren/voices_ref
DEFAULT_VOICE=yaren                # yaren (Chatterbox built-in) | deniz | ada | a recorded voice id
END_OF_TURN_MS=550                 # silence that ends what you say

# --- Long-term memory (agent/memory.py): people.md, notes.md (written by Yaren with her remember /
# forget tools, 1500 characters each) and runs.jsonl (every run, logged automatically). Plain text,
# git-ignored; edit or delete the files to change what she remembers. Read once per conversation.
MEMORY_DIR=${MEMORY_DIR:-run/memory}   # an exported MEMORY_DIR wins (tests)

# --- Mind: a separate Ollama instance pinned to VOICE_GPU (the system one at :11434 is left alone;
# it is 0.32.9, too old for Qwen3.8).
OLLAMA_BIN=${HOME}/opt/ollama-0.40.9/bin/ollama
OLLAMA_PORT=11435
OLLAMA_MODELS=${HOME}/models/ollama
LLM_MODEL=qwen3.8:27b              # vision + tools, Turkish and English. 18 GB (Q4_K_M)
LLM_CTX=8192

# --- "Is it done?": while a task runs, the LLM looks at the wrist camera every DONE_CHECK_EVERY_S;
# DONE_CHECK_STREAK yeses in a row stop the run and send the arm home. 0 = run until the timeout.
# Measured on 30 wrist frames of episodes 90-99 (2026-10-23): 0/20 false YES on start/mid frames
# (pen on the table / in the gripper), 2/10 YES on final frames (the pen is often out of view by
# then), ~350 ms per check. So it never cuts a run short there, but often the timeout ends the run.
DONE_CHECK=1
DONE_CHECK_AFTER_S=5
DONE_CHECK_EVERY_S=1
DONE_CHECK_STREAK=2
