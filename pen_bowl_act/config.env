# ============================================================================
# pen_bowl_act — configuration. EVERY script sources this file; it is the
# single source of truth. Edit values here, never inside the scripts.
#
# Task:   pick up the pen and put it in the bowl (SO-101, one arm)
# Policy: ACT (Action Chunking Transformer), trained from scratch
#         (ImageNet ResNet18 backbone) on THIS machine's two RTX 5090s.
# Camera: ONLY the gripper-mounted (wrist) camera. No overhead camera.
# ============================================================================

# Hugging Face account the dataset is published to.
HF_USER=fouad1233

# Python stack: lelab's uv tool venv (same as tshirt_fold_pi05). It already has
# torch 2.11+cu128 (sm_120, verified on both 5090s), lerobot 0.6.0, accelerate,
# rerun, pynput and matplotlib. ../.venv in this repo has no torch at all.
# Do NOT `uv tool upgrade lelab` while recording/training (see CLAUDE.md).
VENV_BIN=/home/gtu-dsa/.local/share/uv/tools/lelab/bin

# --- Arms -----------------------------------------------------------------
# Identified by USB serial, NOT by /dev/ttyACM number: the ACM numbers swap on
# every replug/reboot. The scripts resolve these serials to the current port
# every time they start. Verified 2026-10-11 by reading each arm's motor
# EEPROM homing offsets and matching them to the calibration files.
LEADER_SERIAL=5B42000617
FOLLOWER_SERIAL=5B42135231
# Calibration ids (files under ~/.cache/huggingface/lerobot/calibration/).
LEADER_ID=dash_so101
FOLLOWER_ID=dash_so101

# --- Task text (identical at record, train and run time) ---------------------
TASK="Pick up the pen and put it in the bowl"

# --- Camera (SINGLE SOURCE OF TRUTH for recording AND running) ---------------
# by-id path, not /dev/videoN (N changes on replug). Find it with
# ./find_camera.sh. The key name "wrist" becomes observation.images.wrist in
# the dataset and in the trained policy, so it must never change after the
# first episode is recorded.
#
# Measured 2026-10-11: this Jieli camera delivers ~25 fps at 640x480 (both
# YUYV and MJPG). Recording still runs at 30 Hz: lerobot reads the newest
# frame without blocking, so ~1 frame in 6 is a repeat. Harmless, and it
# keeps the arm control loop at the standard 30 Hz.
# warmup_s=3: this camera needs ~3 s to deliver its first frame from cold;
# lerobot's default 1 s times out.
# No rotation: the native image has the gripper fingers at the TOP of the
# frame (same as every earlier dataset with this camera). It looks upside
# down to a human but the policy does not care. Never change it mid-dataset.
CAMERAS='{"wrist": {"type": "opencv", "index_or_path": "/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0", "width": 640, "height": 480, "fps": 30, "warmup_s": 3}}'

# --- Recording ---------------------------------------------------------------
TARGET_EPISODES=100           # total demonstrations wanted
EPISODES_PER_SESSION=10       # recording is split into sessions of this size
EPISODE_TIME_S=30             # max length of one demo (press -> to end early)
RESET_TIME_S=15               # pause after each demo to reset the scene (-> skips)
MIN_EPISODE_S=3               # shorter demos are discarded automatically
FPS=30
# Video codec for recorded videos. h264 decodes several times faster than
# lerobot's default AV1 during training, at slightly larger
# files. Measured on this machine: h264+torchcodec feeds 1688 samples/s vs
# 675 for AV1+pyav, which keeps both GPUs busy instead of waiting on the CPU.
VIDEO_CODEC=h264
VIDEO_CRF=23

# --- Datasets ----------------------------------------------------------------
# Each session is its own small dataset. A crash can only ever damage the
# session being recorded, and a bad session is deleted as a unit.
SESSIONS_DIR=${HOME}/.cache/huggingface/lerobot/${HF_USER}/so101_pen_bowl_sessions
SESSION_REPO_PREFIX=${HF_USER}/so101_pen_bowl_session
# The merged dataset that is trained on and published.
DATASET_REPO=${HF_USER}/so101_pen_in_bowl_wrist
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}
PUSH_DATASET_TO_HUB=true
DATASET_PRIVATE=false

# --- Training (2x RTX 5090, accelerate DDP) ----------------------------------
NUM_GPUS=2
# Measured (ACT, bf16, h264+torchcodec): 1 GPU 468 samples/s; 2 GPUs with
# train_act.py's bf16 gradient sync 798 (1.7x); lerobot's stock DDP only 636.
BATCH_SIZE=64                 # per GPU -> effective batch = BATCH_SIZE * NUM_GPUS
NUM_WORKERS=14                # dataloader workers per GPU process
MIXED_PRECISION=bf16
EPOCHS=60
# lr 1e-4 (DETR's rate at this batch size; ACT is built on DETR). Pilot on this
# machine, effective batch 128, after 1 epoch: train loss 0.39 / val 0.458 at
# 1e-4 vs 1.02 / 0.509 at lerobot's batch-8 default of 1e-5.
LR=1e-4
LR_BACKBONE=1e-5
VALIDATION_SPLIT=0.1          # last 10% of episodes held out for the val curve
CHECKPOINT_EVERY_EPOCHS=5
# Image augmentation runs on the CPU inside lerobot's dataloader and was measured
# to cut the data supply ~5x (1688 -> ~190 samples/s), starving both GPUs. Off,
# like lerobot's ACT default. Turn on only if the policy proves fragile to lighting.
AUGMENT=false
OUTPUT_DIR=./outputs/train/act_pen_bowl
JOB_NAME=act_pen_bowl
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
THROUGHPUT_HINT=798            # measured samples/s on 2 GPUs (for the time estimate)

# Publishing the trained model is a separate, explicit step (publish_model.sh).
MODEL_REPO=${HF_USER}/act_pen_in_bowl_wrist

# --- Running the policy (3_run_autonomous.sh) ----------------------------------
# Max degrees any joint may move per control tick (30 Hz). House rule for new
# tasks: always clamp (see CLAUDE.md, cap_sort_pi0). Raise if motion is too
# timid, lower if it snaps.
MAX_RELATIVE_TARGET=5
# ensemble = ACT temporal ensembling (original paper, smoothest, re-plans every
#            tick: n_action_steps=1, coeff 0.01)
# chunk    = execute N_ACTION_STEPS actions of each 100-step chunk, then re-plan
ACTION_MODE=ensemble
TEMPORAL_ENSEMBLE_COEFF=0.01
N_ACTION_STEPS=30
RUN_DURATION_S=0              # 0 = run until Ctrl+C
TRIAL_TIME_S=30               # --trials mode: length of each autonomous trial
TRIAL_RESET_S=20              # --trials mode: pause between trials
