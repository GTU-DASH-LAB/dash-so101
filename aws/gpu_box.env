# Settings for gpu_box.sh (sourced). One machine at a time.
REGION=us-east-1
# p5.4xlarge = 1x H100 80 GB, 16 vCPUs, 256 GB RAM, 3.8 TB local NVMe.
# Needs the 16-vCPU P-instance quota (requested 2026-10-15; see check_quota_requests.sh).
INSTANCE_TYPE=p5.4xlarge
MARKET=spot                    # spot (~$2.6/h, can be reclaimed) or ondemand (~$6.9/h)
PRICE_HINT=2.63                # USD/hour, for the status estimate only (6.88 for ondemand)
MAX_HOURS=10                   # hard limit: the machine deletes itself after this
DISK_GB=300                    # root disk (gp3, deleted with the machine)
# AWS Deep Learning Base AMI: NVIDIA driver + CUDA, Ubuntu 24.04, no Python stack baked in.
AMI_PARAM=/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-24.04/latest/ami-id
BOX_NAME=so101-train
KEY_NAME=so101-train
SG_NAME=so101-train-ssh
