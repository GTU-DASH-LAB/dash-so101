# ============================================================================
# cap_sort_pi0 — configuration (all scripts `source` this file)
# Task: from a cluster of colored bottle caps (green/blue/orange and 2 purple),
# pick up ONLY the purple ones and place them in the pink bowl, on the SO-101.
# Base model for fine-tuning: pi0 (lerobot/pi0_base), via LoRA this time.
# ============================================================================

# Your Hugging Face username (dataset + trained model are published here).
HF_USER=fouad1233

# Push the recorded dataset / trained model to the Hub? Set to false to keep
# everything purely local (e.g. offline, or while iterating before publishing).
PUSH_DATASET_TO_HUB=true
PUSH_MODEL_TO_HUB=true

# --- SO-101 serial ports -----------------------------------------------------
# Teleoperation needs BOTH arms connected. Ports are just USB enumeration
# order, NOT tied to which arm is leader/follower -- they can (and do) swap
# after any replug/reboot. Re-check with `lerobot-find-port` before recording
# if you've unplugged anything since the last session; don't trust these
# blindly. On this Linux box they look like /dev/ttyACM0, /dev/ttyACM1, ...
FOLLOWER_PORT=/dev/ttyACM1
LEADER_PORT=/dev/ttyACM0
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# --- Task (MUST be identical at record + train + run time) -------------------
TASK="Pick up the purple caps and place them in the pink bowl"

# --- Cameras (SINGLE SOURCE OF TRUTH: used for BOTH recording and running) ---
#   top   = overhead workspace view (/dev/video0)
#   wrist = gripper-mounted view    (/dev/video2), rotated 180 + mirrored so the
#           image matches reality (calibrated against the physical setup).
# Keys are named base_0_rgb/left_wrist_0_rgb -- pi0_base's OWN declared camera
# slots -- directly, instead of top/wrist. This means the recorded dataset's
# columns already match what pi0 expects, so (unlike ball_pickup_pi0) NEITHER
# 2_train_local.sh NOR 3_run_autonomous.sh need --rename_map at all. Keeping
# this identical between record and run is still critical either way -- the
# policy must see the same camera names/orientations it was trained on.
# NOTE: top view currently also shows a leftover tennis ball and a marker pen
# from other tasks/clutter -- clear those out of frame before recording so
# they don't get picked up as spurious "signal" by the policy.
CAMERAS='{
  "base_0_rgb":      { "type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 30 },
  "left_wrist_0_rgb": { "type": "opencv", "index_or_path": 2, "width": 640, "height": 480, "fps": 30, "rotation": 180, "mirror": true }
}'

# --- Dataset (saved locally AND pushed to the Hub after recording) -----------
DATASET_REPO=${HF_USER}/so101_cap_sort
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# --- Base model + training output --------------------------------------------
BASE_MODEL=lerobot/pi0_base
OUTPUT_DIR=./outputs/train/pi0_cap_sort
# Where the fine-tuned model (LoRA adapter) is published on the Hub.
MODEL_REPO=${HF_USER}/pi0_cap_sort_lora
# Which policy 3_run_autonomous.sh should load: local checkpoint or the Hub.
POLICY_SOURCE=local

# --- Recording settings ------------------------------------------------------
# Record MORE than ball_pickup_pi0's 15 -- that model undertrained/underfit,
# likely partly due to too few demos for a harder, color-discrimination task.
# Always keep the non-purple caps (green/blue/orange) on the table as
# distractors -- the model needs negative examples to learn to ignore them,
# not just positive examples of the purple ones. Vary the cluster's layout
# and which exact caps are present between episodes.
NUM_EPISODES=50
EPISODE_TIME_S=40                 # seconds per demonstration
RESET_TIME_S=10                   # pause to reset the scene between demos
FPS=30

# --- Training settings (LOCAL, single GPU on this machine, LoRA) -------------
# LoRA freezes ~99% of pi0's 4B params (num_learnable_params drops from 4.03B
# to ~1.4M with r=16), so gradient/optimizer memory -- the dominant cost in
# ball_pickup_pi0's full fine-tune (~78GB at batch_size=8) -- nearly vanishes.
# Verified 2026-07-03 with a real 10-step smoke test on this GPU using
# ball_pickup_pi0's dataset: batch_size=16 steadies around ~59GB (script's
# own reporting; ~88GB system-wide peak including OS/other apps, ~35GB
# headroom left of 121GB) at ~4.4s/step, 4 samples/sec -- 2x the throughput
# of ball_pickup_pi0's full-fine-tune batch_size=8 (~2 samples/sec) at
# essentially the same per-step wall-clock time. Don't raise further without
# re-verifying headroom the same way (see CLAUDE.md for the smoke-test recipe).
BATCH_SIZE=16
STEPS=20000                       # ~4 samples/sec -> ~24.4h. Requested explicitly; lower if that's too long.
SAVE_FREQ=2000                    # 10 checkpoints across the run (resumable)

# --- LoRA (PEFT) settings -----------------------------------------------------
# r=16, alpha=32 (2x r, a common default) targeting pi0's own default modules
# (gemma-expert attention q/v projections + action/state projection layers --
# see PI0Policy._get_default_peft_targets()). Higher r = more trainable
# params = closer to full fine-tuning, at the cost of memory/speed.
PEFT_R=16
PEFT_ALPHA=32
