# ============================================================================
# ball_pickup_pi0 — configuration (all scripts `source` this file)
# Task: pick up the ball and place it in the white cup, on the SO-101.
# Base model for fine-tuning: pi0 (lerobot/pi0_base).
# ============================================================================

# Your Hugging Face username (dataset + trained model are published here).
HF_USER=fouad1233

# Push the recorded dataset / trained model to the Hub? Set to false to keep
# everything purely local (e.g. offline, or while iterating before publishing).
PUSH_DATASET_TO_HUB=true
PUSH_MODEL_TO_HUB=true

# --- SO-101 serial ports -----------------------------------------------------
# Teleoperation needs BOTH arms connected. Find each port with:
#     lerobot-find-port     (it tells you to unplug a device to identify its port)
# On this Linux box they look like /dev/ttyACM0, /dev/ttyACM1, ...
FOLLOWER_PORT=/dev/ttyACM1
LEADER_PORT=/dev/ttyACM0
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# --- Task (MUST be identical at record + train + run time) -------------------
TASK="Pick up the tennis ball and place it in the white cup"

# --- Cameras (SINGLE SOURCE OF TRUTH: used for BOTH recording and running) ---
#   top   = overhead workspace view (/dev/video0)
#   wrist = gripper-mounted view    (/dev/video2), rotated 180 + mirrored so the
#           image matches reality (calibrated against the physical setup).
# Keeping this identical between record and run is critical — the policy must
# see the same camera names/orientations it was trained on.
CAMERAS='{
  "top":   { "type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 30 },
  "wrist": { "type": "opencv", "index_or_path": 2, "width": 640, "height": 480, "fps": 30, "rotation": 180, "mirror": true }
}'

# --- Dataset (saved locally AND pushed to the Hub after recording) -----------
DATASET_REPO=${HF_USER}/so101_ball_pickup
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# --- Base model + training output --------------------------------------------
BASE_MODEL=lerobot/pi0_base
OUTPUT_DIR=./outputs/train/pi0_ball_pickup
# Where the fine-tuned model is published on the Hub after training.
MODEL_REPO=${HF_USER}/pi0_ball_pickup
# The autonomous script loads the newest LOCAL checkpoint from:
#     $OUTPUT_DIR/checkpoints/last/pretrained_model
# (Running from the local checkpoint is faster/works offline; the Hub copy at
# MODEL_REPO is for sharing/backup, not required for 3_run_autonomous.sh.)

# --- Recording settings ------------------------------------------------------
NUM_EPISODES=15                   # start small; you can record more later
EPISODE_TIME_S=40                 # seconds per demonstration
RESET_TIME_S=10                   # pause to reset the scene between demos
FPS=30

# --- Training settings (LOCAL, single GPU on this machine) -------------------
# pi0 is a ~4B-param model. Measured on this GB10 (121GB unified CPU+GPU memory):
# fp32 + batch_size=16 reliably OOMs (needs >113GB). With bf16 mixed precision
# (enabled in 2_train_local.sh via ACCELERATE_MIXED_PRECISION, since the
# `--policy.use_amp` CLI flag is a no-op in this lerobot version) batch_size=8
# steadies at ~78GB/~4.05s/step (~2 samples/sec), though it briefly dips into
# swap during the first couple of warmup steps while CUDA kernels autotune —
# don't raise BATCH_SIZE further without re-testing headroom.
BATCH_SIZE=8
STEPS=10000                       # ~2 samples/sec -> ~11h. Halve/double to trade time for training coverage.
SAVE_FREQ=1000                    # ~1h between checkpoints (resumable) — frequent given the memory margin is tight
