# ============================================================================
# tshirt_fold_pi05 — configuration (all scripts `source` this file)
# Task: fold a t-shirt with one hand, on the SO-101.
# Base model for fine-tuning: pi0.5 (lerobot/pi05_base), via LoRA.
#
# Unlike cap_sort_pi0/ball_pickup_pi0, the dataset was already recorded via
# the lelab web UI (not this project's own 1_record.sh), so there is no
# record script or FOLLOWER_PORT/LEADER_PORT/CAMERAS block here — this folder
# only covers training. See ~/.claude/projects/-home-gtu-dsa/memory/
# lelab-local-patches.md for the recording-side context.
# ============================================================================

# Your Hugging Face username (dataset already lives here; NOT pushing the
# trained model unless explicitly asked — see PUSH_MODEL_TO_HUB below).
HF_USER=fouad1233

# Push the trained model to the Hub after training? Left false: the user
# hasn't asked for a Hub publish for this task, and dash-so101/CLAUDE.md's
# convention is "commit/push only when asked". Flip to true and re-run (or
# push manually from the last checkpoint) if that changes.
PUSH_MODEL_TO_HUB=false

# --- Task (for reference only; already baked into the dataset's metadata) ---
TASK="fold the tshirt"

# --- Dataset (already recorded + cleaned; see lelab-local-patches memory for
#     the episode-cleanup history: 46 episodes / 120,968 frames, 30fps) -------
DATASET_REPO=${HF_USER}/so101_fold_tshirt_one_hand_20260813_131406
DATASET_ROOT=${HOME}/.cache/huggingface/lerobot/${DATASET_REPO}

# --- Camera name remapping (REQUIRED for this dataset) -----------------------
# The dataset was recorded through the lelab web UI, which named its cameras
# `workspace_cam`/`wrist_camera`. pi05_base's config.json declares its own
# slots as observation.images.{base_0_rgb,left_wrist_0_rgb,right_wrist_0_rgb}.
# Without this remap, make_policy raises `Feature mismatch` (the strict check
# in factory.py only runs when no rename_map is given). Leaving the third slot
# (right_wrist_0_rgb) unfilled is fine -- pi0.5 masks out declared-but-absent
# image keys internally. Same gotcha ball_pickup_pi0 hit; see CLAUDE.md.
# NOTE: rename_map only remaps the DATASET's columns at training time -- the
# fine-tuned checkpoint keeps pi0.5's original slot names permanently, so any
# future rollout/inference script needs this exact same map too.
RENAME_MAP='{"observation.images.workspace_cam": "observation.images.base_0_rgb", "observation.images.wrist_camera": "observation.images.left_wrist_0_rgb"}'

# --- Python environment -------------------------------------------------------
# NOTE: this deviates from dash-so101/CLAUDE.md's "use ../.venv" convention,
# deliberately. Building a fresh .venv requires ~3GB of torch+nvidia wheels,
# and this network is per-connection throttled (~665 KB/s/stream), which put
# that download over 70 minutes with no end in sight. lelab's tool venv
# already has a verified-working stack for exactly this job:
#   torch 2.11.0+cu128 (sm_120, real bf16 matmul verified on BOTH GPUs),
#   NCCL available (required for the 2-GPU DDP run), lerobot 0.6.0 with pi05,
#   accelerate 1.14.0, transformers 5.5.4; only peft + matplotlib were added.
# Its local patches (see memory/lelab-local-patches.md) are in recording and
# dataset code and don't affect training -- patch #4 (torchcodec->pyav
# fallback) actively helps, since we pass --dataset.video_backend=pyav anyway.
# CAUTION: `uv tool upgrade lelab` would wipe peft/matplotlib AND those
# patches out from under a running job. Don't upgrade lelab while training.
VENV_BIN=/home/gtu-dsa/.local/share/uv/tools/lelab/bin

# --- Base model + training output --------------------------------------------
# Local directory, not the "lerobot/pi05_base" Hub id: the 14.47GB weights
# were pulled with aria2c -x16 because HF's own downloader stalled repeatedly
# on this network (dead sockets, restarting from zero instead of resuming).
# lerobot's from_pretrained accepts a local path identically.
BASE_MODEL=/home/gtu-dsa/models/pi05_base
OUTPUT_DIR=./outputs/train/pi05_tshirt_fold
# Where the fine-tuned model (LoRA adapter) would be published on the Hub,
# if PUSH_MODEL_TO_HUB is ever flipped to true.
MODEL_REPO=${HF_USER}/pi05_tshirt_fold_lora

# --- GPUs ----------------------------------------------------------------
# This machine: 2x RTX 5090, no NVLink/P2P, GPU1 on a narrower (x4) PCIe
# link than GPU0. House rule (robotics/CLAUDE.md) normally prefers
# independent single-GPU runs over DDP for VLA fine-tuning, BUT the user
# explicitly asked to use both GPUs here if it's actually faster. With LoRA,
# only ~1.4M params' gradients cross PCIe per step (a few MB) -- negligible
# next to per-step compute time even over the x4 link -- so real DDP speedup
# is expected and was verified with a smoke test (see watchdog.log /
# 2_train_local.sh comments) before committing to it for the full run.
NUM_GPUS=2

# --- Training settings (LoRA, filled in from a real smoke test on THIS
#     machine's actual 32GB-per-GPU RTX 5090s -- the "GB10 121GB unified
#     memory" numbers in cap_sort_pi0/ball_pickup_pi0's CLAUDE.md notes are
#     from a different, unified-memory machine and do NOT apply here). ------
BATCH_SIZE=16                       # per-process; effective = BATCH_SIZE * NUM_GPUS = 32
# Chosen from three real 12-step smoke tests on these actual cards
# (bf16 + gradient checkpointing throughout -- see the precision block below):
#
#   per-GPU bs |  s/step  | samples/s | peak VRAM/card | % of 32,607 MiB
#   -----------+----------+-----------+----------------+-----------------
#        8     |  0.96    |    17     |  13.5 / 12.8 GB|    41% / 39%
#       16     |  1.96    |    16     |  16.4 / 15.7 GB|    50% / 48%
#
# Step time scales almost exactly linearly with batch size while samples/s
# stays flat -- the GPUs are compute-bound, not batch-starved, so a bigger
# batch buys no throughput. It buys *data per step*: with STEPS fixed at
# 20,000 by request, effective batch 32 sees 5.3 epochs of the 120,968-frame
# dataset instead of 2.6, with lower-variance gradients, for 11h instead of
# 5.4h. Effective 32 is also what openpi/lerobot use as the pi0.5 fine-tuning
# default, so the LR defaults below are tuned for it. 50% VRAM headroom is
# deliberate: an allocator that survives 12 steps is not proof it survives
# 20,000, and an OOM at hour 9 costs everything since the last checkpoint.
#
# That same linearity answers "do 2 GPUs actually make it faster?" (the user's
# condition for using both): one GPU at the same effective batch of 32 would
# run ~3.9 s/step, so two at 1.96 s/step is a true ~2x. The 1.28M LoRA
# gradients crossing the x4 PCIe link each step cost nothing measurable.

# --- Precision (this is what makes pi0.5 fit in 32GB at all) ------------------
# MEASURED: the naive setup (policy.dtype=float32 + ACCELERATE_MIXED_PRECISION=
# bf16) OOMs on BOTH cards even at batch_size=8, with only 1.28M learnable
# params. The batch was never the problem -- the 4.14B *base* weights were:
#   fp32 weights                                    16.6 GB
# + autocast's cached bf16 copy of every weight it touches  ~8 GB
# + activations/workspace                                   ~5 GB
#   ------------------------------------------------------------
#   ~30 GB of a 31.4 GB usable card -> OOM (observed: 30.98 GB in use,
#   353 MiB free, failing on a 254 MiB alloc).
#
# POLICY_DTYPE=bfloat16 is pi0.5's own built-in fix and matches upstream
# openpi's reference recipe: PI05Config.dtype -> PaliGemmaWithExpertModel(
# precision=...) -> to_bfloat16_for_selected_params(), which casts the
# transformer to bf16 but DELIBERATELY keeps vision_tower,
# multi_modal_projector, the input/post_attention layernorms and model.norm in
# float32 (see modeling_pi05.py:406). So it is not a blunt .half() -- the
# numerically sensitive parts stay fp32 by design.
#
# ACCEL_MP is then set to "no" on purpose. Leaving Accelerate's autocast on
# would (a) re-cast the vision path the model just went out of its way to keep
# in fp32, and (b) reintroduce the duplicate weight cache that caused the OOM.
# The bf16 params already do bf16 matmuls natively -- autocast adds nothing.
POLICY_DTYPE=bfloat16
ACCEL_MP=no

# MEASURED, round 2: bfloat16 alone was NOT enough. It did free the ~8GB it
# should have, but the run still OOMed at ~30GB -- this time inside the gemma
# MLP forward (modeling_pi05.py:300, `layer.mlp(out_emb)`) rather than at
# weight load. That relocation is the whole diagnosis: the remaining ~21GB is
# ACTIVATIONS, not parameters.
#
# The intuition trap here is thinking LoRA makes a model cheap. LoRA makes the
# *optimizer* cheap (1.28M trainable params instead of 4.14B). It does nothing
# for activations: the adapters sit inside the frozen transformer, so backprop
# still has to traverse every layer, and every layer's forward activations must
# be kept alive for it. ~760 tokens/sample (2x256 image + 200 text + 50 action)
# x 8 samples x 18 gemma layers of width 2048/ffn 16384 is where the 21GB goes.
#
# Gradient checkpointing is the direct fix: discard intermediate activations
# and recompute them during backward. Costs roughly 30% more time per step and
# buys back the majority of that 21GB. pi0.5 implements it with
# `use_reentrant=False` (modeling_pi05.py:509,545), which is the variant that
# still propagates gradients correctly when the checkpointed block's own inputs
# are frozen -- i.e. exactly the LoRA case. The older reentrant variant would
# silently produce zero gradients here.
GRADIENT_CHECKPOINTING=true

# STEPS/SAVE_FREQ set by the user explicitly (2026-08-13).
# Note on the LR schedule: PI05Config defaults are scheduler_warmup_steps=1000
# and scheduler_decay_steps=30000, but lerobot auto-scales both down when
# --steps is smaller than scheduler_decay_steps, so the cosine decay still
# completes cleanly at 20000 rather than being truncated mid-decay.
STEPS=20000
SAVE_FREQ=2500                      # 8 checkpoints across the run (each resumable)

# --- LoRA (PEFT) settings -----------------------------------------------------
# r=16, alpha=32: same defaults cap_sort_pi0 verified working for pi0's own
# LoRA target modules; pi0.5 (PI05Policy) follows the same default-target
# pattern via _get_default_peft_targets().
PEFT_R=16
PEFT_ALPHA=32

# --- Robot + cameras for inference (stage 3) ---------------------------------
# Copied verbatim from ~/.cache/huggingface/lerobot/robots/dash_so101.json --
# the lelab config that actually RECORDED this dataset. Do not "improve" these
# values: the policy has to see the world exactly as it was trained.
#
# NOTE the follower is ttyACM0 here. ball_pickup_pi0/cap_sort_pi0's config.env
# both say FOLLOWER_PORT=/dev/ttyACM1 -- that is not a project-wide constant,
# it is just USB enumeration order and it differs for this setup. Verified
# against lelab's own ports/follower_port.txt.
FOLLOWER_PORT=/dev/ttyACM0
FOLLOWER_ID=dash_so101

# ttyACM numbering is USB enumeration order and DOES swap on replug (see
# robotics/dash-so101/CLAUDE.md). It already moved once during the recording
# session itself: lelab wrote its config at 13:06 with follower_port=ttyACM0,
# an arm was re-enumerated at 14:17, and recording still finished fine at
# 15:46 -- which is what pins the mapping below. ttyACM1 held 5B42000617
# continuously from 12:29, so the device that reclaimed ttyACM0 is 5B42135231.
#
# The USB serial is the stable identity. 3_run_autonomous.sh refuses to start
# if FOLLOWER_PORT no longer points at this serial, rather than silently
# driving the leader arm.
FOLLOWER_SERIAL=5B42135231

# by-id paths, not /dev/videoN: the N shifts on every replug (it already did
# once while setting this up). These symlinks are stable per physical camera.
#   workspace_cam = Logitech C505  (overhead view of the table)
#   wrist_camera  = Jieli generic  (gripper-mounted, fingers visible in frame)
# No rotation and no fourcc override -- lelab recorded with neither.
# warmup_s=3 is the ONLY deviation from the recording config, and it changes no
# pixels: OpenCVCamera.connect() warms up with async_read(timeout_ms=warmup_s*1000)
# (camera_opencv.py:173) and warmup_s defaults to 1. The C505 measurably needs
# ~1.8s to deliver its FIRST frame from cold, so the default 1000ms timeout loses
# the race and connect() dies with "Timed out waiting for frame ... after 1000 ms".
# Once open it streams a steady 29.9 fps. Resolution/fps/rotation/fourcc are
# untouched, so the policy still sees exactly the images it was trained on.
CAMERAS='{"workspace_cam": {"type": "opencv", "index_or_path": "/dev/v4l/by-id/usb-046d_C505_HD_Webcam_56076BC0-video-index0", "width": 640, "height": 480, "fps": 30, "warmup_s": 3}, "wrist_camera": {"type": "opencv", "index_or_path": "/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0", "width": 640, "height": 480, "fps": 30, "warmup_s": 3}}'

# Per-step joint clamp (degrees). dash-so101/CLAUDE.md's standing rule: include
# this in any NEW task's run script. RTC's chunk-boundary action noise
# otherwise translates straight into full-speed servo jumps. Raise it if the
# folding motion looks unnaturally slow; drop it to 3 if the arm snaps.
MAX_RELATIVE_TARGET=5
